# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (solo servidor)
ANTHROPIC_API_KEY=

# Stripe (modo test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Resend
RESEND_API_KEY=
# D7: sin dominio propio Resend solo entrega a la dirección de la cuenta. Direcciones separadas por
# comas a las que se permite enviar. Fuera de producción, sin esta lista no se envía nada.
EMAIL_ALLOWLIST=
# Opcional. Por defecto "BUDDY <onboarding@resend.dev>" (el único remitente válido sin dominio).
EMAIL_FROM=
# Opcional. URL base de los enlaces de los emails; por defecto, la que da Vercel en cada entorno.
APP_URL=

# Cron (Vercel)
CRON_SECRET=
